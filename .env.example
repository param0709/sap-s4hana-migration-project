# Copy to .env before running docker compose.

# --- Application ---
APP_ENV=local

# --- PostgreSQL ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=migration_copilot
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Used when running the backend outside Docker; inside Compose this is set for you.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/migration_copilot
STORAGE_DIR=storage
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
